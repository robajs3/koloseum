@@ -41,6 +41,38 @@ def create_app(config_class=Config) -> Flask:
     def root():
         return redirect(PREFIX + "/")
 
+    # PWA: service worker (musi być serwowany spod prefiksu appki, żeby
+    # jego "scope" obejmował /koloseum/, inaczej przeglądarka nie pozwoli
+    # zainstalować appki spod /static/)
+    @app.route(PREFIX + "/service-worker.js")
+    def service_worker():
+        response = send_from_directory(app.static_folder, "service-worker.js")
+        response.headers["Service-Worker-Allowed"] = PREFIX + "/"
+        response.headers["Cache-Control"] = "no-cache"
+        response.headers["Content-Type"] = "application/javascript"
+        return response
+
+    # PWA: web app manifest, generowany dynamicznie żeby start_url/scope
+    # zawsze zgadzały się z aktualnym PREFIX
+    @app.route(PREFIX + "/manifest.webmanifest")
+    def web_manifest():
+        manifest = {
+            "name": "Koloseum",
+            "short_name": "Koloseum",
+            "start_url": PREFIX + "/",
+            "scope": PREFIX + "/",
+            "display": "standalone",
+            "background_color": "#0f1115",
+            "theme_color": "#0f1115",
+            "icons": [
+                {"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
+                {"src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
+            ],
+        }
+        response = jsonify(manifest)
+        response.headers["Content-Type"] = "application/manifest+json"
+        return response
+
     # Template globals
     @app.context_processor
     def inject_globals():
