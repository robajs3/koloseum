diff --git a/static/js/pwa-install.js b/static/js/pwa-install.js
new file mode 100644
index 0000000..942e33c
--- /dev/null
+++ b/static/js/pwa-install.js
@@ -0,0 +1,44 @@
+// static/js/pwa-install.js
+// Rejestruje service workera i obsługuje przycisk "Zainstaluj aplikację".
+// Oczekuje w DOM elementu #pwa-install-btn (patrz templates/partials/pwa_install.html).
+
+(function () {
+  const SW_URL = window.KOLOSEUM_SW_URL;
+  const SW_SCOPE = window.KOLOSEUM_PREFIX ? window.KOLOSEUM_PREFIX + "/" : "/";
+
+  if ("serviceWorker" in navigator && SW_URL) {
+    window.addEventListener("load", () => {
+      navigator.serviceWorker
+        .register(SW_URL, { scope: SW_SCOPE })
+        .catch((err) => console.warn("Nie udało się zarejestrować service workera:", err));
+    });
+  }
+
+  let deferredPrompt = null;
+  const installBtn = document.getElementById("pwa-install-btn");
+
+  if (!installBtn) return;
+
+  // Domyślnie ukryty - pokazujemy dopiero, gdy przeglądarka faktycznie
+  // pozwala zainstalować appkę
+  installBtn.hidden = true;
+
+  window.addEventListener("beforeinstallprompt", (event) => {
+    event.preventDefault();
+    deferredPrompt = event;
+    installBtn.hidden = false;
+  });
+
+  installBtn.addEventListener("click", async () => {
+    if (!deferredPrompt) return;
+    installBtn.hidden = true;
+    deferredPrompt.prompt();
+    await deferredPrompt.userChoice;
+    deferredPrompt = null;
+  });
+
+  window.addEventListener("appinstalled", () => {
+    installBtn.hidden = true;
+    deferredPrompt = null;
+  });
+})();
diff --git a/static/service-worker.js b/static/service-worker.js
new file mode 100644
index 0000000..a12ba95
--- /dev/null
+++ b/static/service-worker.js
@@ -0,0 +1,48 @@
+// static/service-worker.js
+// Minimalny service worker pod PWA "zainstaluj aplikację".
+// Cache'uje app shell, żeby appka dało się zainstalować i otworzyć offline
+// (bez świeżych danych, ale bez białego ekranu).
+
+const CACHE_NAME = "koloseum-shell-v1";
+const APP_SHELL = [
+  self.registration.scope, // np. /koloseum/
+];
+
+self.addEventListener("install", (event) => {
+  event.waitUntil(
+    caches.open(CACHE_NAME).then((cache) => cache.addAll(APP_SHELL))
+  );
+  self.skipWaiting();
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil(
+    caches.keys().then((keys) =>
+      Promise.all(
+        keys
+          .filter((key) => key !== CACHE_NAME)
+          .map((key) => caches.delete(key))
+      )
+    )
+  );
+  self.clients.claim();
+});
+
+self.addEventListener("fetch", (event) => {
+  const { request } = event;
+
+  // Tylko GET, tylko ten sam origin - reszty (API, POST) nie ruszamy
+  if (request.method !== "GET" || new URL(request.url).origin !== self.location.origin) {
+    return;
+  }
+
+  event.respondWith(
+    fetch(request)
+      .then((response) => {
+        const copy = response.clone();
+        caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
+        return response;
+      })
+      .catch(() => caches.match(request).then((cached) => cached || caches.match(self.registration.scope)))
+  );
+});
diff --git a/templates/partials/pwa_install.html b/templates/partials/pwa_install.html
new file mode 100644
index 0000000..d2e5fc6
--- /dev/null
+++ b/templates/partials/pwa_install.html
@@ -0,0 +1,16 @@
+{# Dołącz w <head> layoutu bazowego (np. templates/base.html):
+     <link rel="manifest" href="{{ manifest_url }}">
+     <meta name="theme-color" content="#0f1115">
+
+   Dołącz gdzieś w widocznym miejscu (np. sidebar, obok linków Dysk/Planowiec):
+     {% include "partials/pwa_install.html" %}
+#}
+<button id="pwa-install-btn" type="button" class="btn-install-app" hidden>
+    Zainstaluj aplikację
+</button>
+
+<script>
+  window.KOLOSEUM_PREFIX = "{{ prefix }}";
+  window.KOLOSEUM_SW_URL = "{{ service_worker_url }}";
+</script>
+<script src="{{ url_for('static', filename='js/pwa-install.js') }}" defer></script>