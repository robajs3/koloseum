# ============================================
# Zmienne dla uruchomienia PRZEZ DOCKER COMPOSE
# ============================================
# Skopiuj do .env obok docker-compose.yml: `cp .env.docker.example .env`

# Tajny klucz Flask — wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dane bazy — muszą się zgadzać z tym, co dostanie kontener "db" w compose
DB_USER=koloseum_user
DB_PASSWORD=koloseum_pass
DB_NAME=koloseum

# Port na hostcie, pod którym appka będzie widoczna (Tailscale Serve
# wskazuje właśnie na ten port) — wcześniej usługa systemd stała na 5001,
# więc domyślnie zostawiamy ten sam numer, żeby nie trzeba było przepinać
# Tailscale Serve.
APP_PORT=5001

SESSION_COOKIE_SECURE=false

# Prefix URL aplikacji, widziany przez przeglądarkę/Tailscale Serve —
# faktycznie używany (PrefixMiddleware w app.py doklein go do SCRIPT_NAME,
# bo Tailscale --set-path ściera go z requestu zanim trafi do Flaska).
PREFIX=/koloseum

# ============================================
# Konfiguracja FileVault (magazyn plików — NIE logowanie)
# ============================================
FILEVAULT_BASE_URL=http://localhost:8000

# ============================================
# Konfiguracja Push Notyfikacji (Web Push) — opcjonalne
# ============================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# ============================================
# Konfiguracja SSO (LoginHub)
# ============================================

# Wspólny sekret między appkami — DOKŁADNIE ta sama wartość co w .env LoginHub.
SSO_SECRET=

# Appka dockerowa podłączona do sso_net gada z hub-web po nazwie kontenera.
HUB_INTERNAL_URL=http://hub-web:8000

# ============================================
# Podsumowania AI materiałów PDF — lokalna Ollama na CPU/RAM (opcjonalne)
# ============================================
AI_SUMMARY_ENABLED=true
OLLAMA_URL=http://ollama:11434
# Szybsze na CPU: gemma3:4b (domyślny), llama3.2:3b, qwen2.5:3b. Wolniejsze, ale dokładniejsze: qwen2.5:7b
AI_SUMMARY_MODEL=gemma3:4b
# Ile znaków PDF-a w ogóle czytamy (max 10 fragmentów). Dłuższy plik = dłuższe generowanie.
AI_SUMMARY_MAX_CHARS=40000
# Rozmiar jednego fragmentu. Dokument krótszy niż to idzie jednym zapytaniem.
AI_SUMMARY_CHUNK_CHARS=6000
AI_SUMMARY_NUM_CTX=4096
# 0 = bez limitu długości odpowiedzi
AI_SUMMARY_MAX_TOKENS=0
# 0 = auto; najlepiej liczba fizycznych rdzeni CPU (sprawdź: lscpu)
AI_SUMMARY_NUM_THREADS=0
AI_SUMMARY_TIMEOUT=900
AI_SUMMARY_DAILY_LIMIT=30
