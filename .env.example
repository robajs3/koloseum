# ============================================
# Zmienne wymagane do uruchomienia aplikacji
# ============================================
#
# UWAGA: ten plik to wariant dla uruchomienia BEZ Dockera (np. usługa
# systemd na hoście). Jeśli używasz `docker compose up`, skopiuj zamiast
# tego .env.docker.example do .env — tam DATABASE_URL/HUB_INTERNAL_URL
# wskazują na kontenery, a nie na localhost.
#

# Tajny klucz dla Flask - używany do szyfrowania sesji i cookies
# Wygeneruj losową wartość: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_it_in_production

# URL do bazy danych PostgreSQL
# Format: postgresql://user:password@host:port/database
# Przykład: postgresql://postgres:password@localhost:5432/koloseum
DATABASE_URL=postgresql://user:password@localhost:5432/koloseum

# Folder do przechowywania uploadów (pliki użytkowników)
# Domyślnie: uploads (w głównym katalogu projektu)
UPLOAD_FOLDER=uploads

# URL do serwera Redis - używany do sesji i cache'a
# Format: redis://[:password]@host:port/database
REDIS_URL=redis://localhost:6379

# ============================================
# Konfiguracja FileVault (usługa do przechowywania plików)
# ============================================

# Bazowy URL serwera FileVault (link "Otwórz FileVault" / linkowanie plików
# w materiałach przedmiotu — magazyn plików, NIE logowanie)
FILEVAULT_BASE_URL=http://localhost:8000

# UWAGA: żeby "Podgląd folderu" (iframe) na stronie przedmiotu działał,
# FileVault musi jawnie zezwolić na osadzanie się w ramce z TEGO adresu
# (publicznego adresu Koloseum widzianego przez przeglądarkę, nie tego
# powyżej). Ustaw w .env FileVault:
#   FRAME_ALLOWED_ORIGINS=<publiczny adres Koloseum, np. https://twoja-domena.pl>
# Domyślnie FileVault blokuje osadzanie wszędzie (ochrona przed
# clickjackingiem), więc bez tego podgląd zawsze pokaże fallback
# "otwórz w nowej karcie".

# ============================================
# Konfiguracja SSO (LoginHub)
# ============================================

# Wspólny sekret między appkami — DOKŁADNIE ta sama wartość co w .env LoginHub.
SSO_SECRET=

# Appka systemd (nie Docker) — LoginHub nasłuchuje lokalnie na tym porcie.
HUB_INTERNAL_URL=http://127.0.0.1:8011

# ============================================
# Konfiguracja Push Notyfikacji (Web Push)
# ============================================

# Klucz publiczny VAPID - wysyłane do przeglądarki
# Wygeneruj: python -c "from pywebpush import generate_keys; keys=generate_keys(); print(f'Public: {keys[\"public_key\"]}\nPrivate: {keys[\"private_key\"]}')"
VAPID_PUBLIC_KEY=your_vapid_public_key

# Klucz prywatny VAPID - przechowywany na serwerze
VAPID_PRIVATE_KEY=your_vapid_private_key

# Email do VAPID (wymagany przez standard - może być dowolny)
VAPID_CLAIMS_EMAIL=your-email@example.com

# ============================================
# Inne opcje konfiguracji (opcjonalne)
# ============================================

# Bezpieczne cookies (HTTPS) - ustaw na "true" w produkcji
SESSION_COOKIE_SECURE=false

# Prefix URL aplikacji
PREFIX=/koloseum

# ============================================
# Podsumowania AI materiałów PDF — lokalna Ollama na CPU/RAM (opcjonalne)
# ============================================
AI_SUMMARY_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
# Szybsze na CPU: gemma3:4b (domyślny), llama3.2:3b, qwen2.5:3b. Wolniejsze, ale dokładniejsze: qwen2.5:7b
AI_SUMMARY_MODEL=gemma3:4b
# Mniej znaków = szybciej (czas rośnie z długością wejścia)
AI_SUMMARY_MAX_CHARS=10000
AI_SUMMARY_NUM_CTX=4096
AI_SUMMARY_MAX_TOKENS=700
# 0 = auto; najlepiej liczba fizycznych rdzeni CPU (sprawdź: lscpu)
AI_SUMMARY_NUM_THREADS=0
AI_SUMMARY_TIMEOUT=900
AI_SUMMARY_DAILY_LIMIT=30
