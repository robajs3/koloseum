diff --git a/templates/profile/install_app.html b/templates/profile/install_app.html
new file mode 100644
index 0000000..77f865e
--- /dev/null
+++ b/templates/profile/install_app.html
@@ -0,0 +1,114 @@
+{% extends "base.html" %}
+{% block title %}Zainstaluj aplikację — Koloseum{% endblock %}
+{% block page_title %}Zainstaluj aplikację{% endblock %}
+
+{% block content %}
+<div style="max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:20px">
+
+  <div class="card">
+    <div class="card-body">
+      <p style="font-size:.88rem;color:var(--text-muted)">
+        Koloseum możesz zainstalować jak normalną aplikację — dostaniesz ikonę na ekranie
+        głównym / w szufladzie aplikacji, appka otworzy się bez paska adresu przeglądarki,
+        a jeśli włączysz powiadomienia push w
+        <a href="{{ url_for('profile.profile') }}">profilu</a>, będą przychodzić jak z
+        natywnej aplikacji.
+      </p>
+    </div>
+  </div>
+
+  <!-- ANDROID -->
+  <div class="card">
+    <div class="card-header">
+      <h3><i class="fab fa-android" style="color:#3ddc84;margin-right:8px"></i>Android (Chrome / Edge)</h3>
+    </div>
+    <div class="card-body">
+      <div class="install-steps">
+
+        <div class="install-step">
+          <div class="install-step-num">1</div>
+          <div class="install-step-body">
+            <p>Otwórz Koloseum w Chrome i dotknij ikony <strong>trzech kropek (⋮)</strong> w prawym górnym rogu ekranu.</p>
+            <div class="screenshot-placeholder">
+              <i class="fas fa-camera"></i>
+              Miejsce na screenshot<br>Krok 1 — menu ⋮
+            </div>
+          </div>
+        </div>
+
+        <div class="install-step">
+          <div class="install-step-num">2</div>
+          <div class="install-step-body">
+            <p>Z menu wybierz <strong>„Zainstaluj aplikację”</strong>. Jeśli tej opcji nie widzisz od razu, poszukaj jej pod <strong>„Utwórz skrót”</strong> — na niektórych telefonach jest tam schowana.</p>
+            <div class="screenshot-placeholder">
+              <i class="fas fa-camera"></i>
+              Miejsce na screenshot<br>Krok 2 — „Zainstaluj aplikację”
+            </div>
+          </div>
+        </div>
+
+        <div class="install-step">
+          <div class="install-step-num">3</div>
+          <div class="install-step-body">
+            <p>Potwierdź przyciskiem <strong>„Zainstaluj”</strong> w oknie, które się pojawi. Ikona Koloseum wyląduje na ekranie głównym / w szufladzie aplikacji.</p>
+            <div class="screenshot-placeholder">
+              <i class="fas fa-camera"></i>
+              Miejsce na screenshot<br>Krok 3 — potwierdzenie „Zainstaluj”
+            </div>
+          </div>
+        </div>
+
+      </div>
+    </div>
+  </div>
+
+  <!-- iOS -->
+  <div class="card">
+    <div class="card-header">
+      <h3><i class="fab fa-apple" style="margin-right:8px"></i>iPhone / iPad (Safari)</h3>
+    </div>
+    <div class="card-body">
+      <p style="font-size:.82rem;color:var(--text-muted);margin-bottom:14px">
+        Musi być otwarte w <strong>Safari</strong> — Chrome na iOS nie ma opcji dodania do ekranu głównego.
+      </p>
+      <div class="install-steps">
+
+        <div class="install-step">
+          <div class="install-step-num">1</div>
+          <div class="install-step-body">
+            <p>Otwórz Koloseum w Safari i dotknij ikony <strong>Udostępnij</strong> <i class="fas fa-arrow-up-from-bracket"></i> na dole ekranu.</p>
+            <div class="screenshot-placeholder">
+              <i class="fas fa-camera"></i>
+              Miejsce na screenshot<br>Krok 1 — ikona Udostępnij
+            </div>
+          </div>
+        </div>
+
+        <div class="install-step">
+          <div class="install-step-num">2</div>
+          <div class="install-step-body">
+            <p>Przewiń listę opcji i wybierz <strong>„Dodaj do ekranu początkowego”</strong>.</p>
+            <div class="screenshot-placeholder">
+              <i class="fas fa-camera"></i>
+              Miejsce na screenshot<br>Krok 2 — „Dodaj do ekranu początkowego”
+            </div>
+          </div>
+        </div>
+
+        <div class="install-step">
+          <div class="install-step-num">3</div>
+          <div class="install-step-body">
+            <p>Potwierdź przyciskiem <strong>„Dodaj”</strong> w prawym górnym rogu. Ikona pojawi się na ekranie głównym.</p>
+            <div class="screenshot-placeholder">
+              <i class="fas fa-camera"></i>
+              Miejsce na screenshot<br>Krok 3 — potwierdzenie „Dodaj”
+            </div>
+          </div>
+        </div>
+
+      </div>
+    </div>
+  </div>
+
+</div>
+{% endblock %}
